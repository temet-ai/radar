    },
    {
      "block": "section",
      "blocks": [
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "The address you use for Jira, like ankh-morpork.atlassian.net."
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "Paste any Jira link; radar keeps the site part."
            }
          ]
        }
      ],
      "mark": "site",
      "title": "SITE"
    },
    {
      "block": "section",
      "blocks": [
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "The email you sign in to Atlassian with, on your profile:"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "accent",
              "link": "https://id.atlassian.com/manage-profile/profile-and-visibility",
              "text": "id.atlassian.com / profile"
            }
          ]
        }
      ],
      "mark": "person",
      "title": "EMAIL"
    },
    {
      "block": "section",
      "blocks": [
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "1 Open Atlassian's API token page:"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "accent",
              "link": "https://id.atlassian.com/manage-profile/security/api-tokens",
              "text": "id.atlassian.com / api tokens"
            },
            {
              "ink": "muted",
              "text": "   o opens · y copies"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "2 Create API token, label it radar, pick an expiry, then Create."
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "3 Copy it now: Atlassian shows it once. Paste it into token, or:"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "muted",
              "text": "$ "
            },
            {
              "ink": "primary",
              "text": "export JIRA_TOKEN=…"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "  then the token is env:JIRA_TOKEN"
            }
          ]
        }
      ],
      "detail": "about a minute",
      "mark": "connection",
      "title": "API TOKEN"
    },
    {
      "block": "section",
      "blocks": [
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "401: the email and token don't match, or the token expired."
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "Company login (SSO)? An API token still works; ask your admin if API tokens are switched off."
            }
          ]
        }
      ],
      "mark": "warning",
      "title": "IF IT IS REFUSED"
    },
    {
      "block": "section",
      "blocks": [
        {
          "block": "line",
          "text": [
            {
              "ink": "accent",
              "link": "https://support.atlassian.com/atlassian-account/docs/manage-api-tokens-for-your-atlassian-account/",
              "text": "Atlassian: manage API tokens"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "accent",
              "link": "https://github.com/temet-ai/radar/blob/main/docs/user-guide/connect.md#jira",
              "text": "radar guide: connect Jira"
            }
          ]
        }
      ],
      "mark": "link",
      "title": "MORE"
    }
