          "target": "chrome:tab:4"
        },
        {
          "label": "work items",
          "mnemonic": "I",
          "target": "chrome:tab:6"
        },
        {
          "icon": "log",
          "label": "history",
          "mnemonic": "H",
          "target": "chrome:history"
        },
        {
          "icon": "settings",
          "label": "settings",
          "mnemonic": ",",
          "target": "chrome:settings"
        }
      ]
