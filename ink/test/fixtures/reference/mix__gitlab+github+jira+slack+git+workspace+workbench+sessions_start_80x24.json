            {
              "chord": {
                "key": {
                  "char": "q"
                }
              },
              "label": "q",
              "target": "chrome:key:0:0"
            }
          ],
          "label": "quit"
        },
        {
          "icon": "menu",
          "keys": "x",
          "keys_of": [
            {
              "chord": {
                "key": {
                  "char": "x"
                }
              },
              "label": "x",
              "target": "chrome:key:1:0"
            }
          ],
          "label": "menu"
        },
        {
          "keys": "←→↑↓",
          "keys_of": [
            {
              "chord": {
                "key": "left"
              },
              "label": "←",
              "target": "chrome:key:2:0"
            },
            {
              "chord": {
                "key": "right"
              },
              "label": "→",
              "target": "chrome:key:2:1"
            },
            {
              "chord": {
                "key": "up"
              },
              "label": "↑",
              "target": "chrome:key:2:2"
            },
            {
              "chord": {
                "key": "down"
              },
              "label": "↓",
              "target": "chrome:key:2:3"
            }
          ],
          "label": "navigate"
        }
      ],
      "least_needed": [
        "navigate",
        "scroll",
        "quit",
        "expand/collapse"
      ],
      "scope": "REPOSITORIES"
