      {
        "key": "1",
        "pane": "middle"
      }
    ],
    "screen_keys": [
      "R",
      "G",
      "J",
      "S",
      "B",
      "W",
      "I"
    ],
    "status": {
      "hints": [
        {
          "icon": "quit",
