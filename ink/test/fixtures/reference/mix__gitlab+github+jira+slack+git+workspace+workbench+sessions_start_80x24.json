          "keys_of": [
            {
              "chord": {
                "key": {
                  "char": "q"
                }
              },
              "label": "q",
              "target": "chrome:key:0:0"
            }
          ],
          "label": "quit",
          "mnemonic_at": 0
        },
        {
          "icon": "menu",
          "keys": "x",
          "keys_of": [
            {
              "chord": {
                "key": {
                  "char": "x"
                }
              },
              "label": "x",
              "target": "chrome:key:1:0"
            }
          ],
          "label": "extra actions",
          "mnemonic_at": 1
        },
        {
          "keys": "~",
          "keys_of": [
            {
              "chord": {
                "key": {
                  "char": "~"
                }
              },
              "label": "~",
              "target": "chrome:key:2:0"
            }
