        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "Public repositories need none. For private ones:"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "1 Open the fine-grained token page:"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "accent",
              "link": "https://github.com/settings/personal-access-tokens/new?name=radar&description=radar&contents=read&pull_requests=read&actions=read&statuses=read",
              "text": "github.com / new token"
            },
            {
              "ink": "muted",
              "text": "   "
            },
            {
              "look": "text.muted underline",
              "text": "o"
            },
            {
              "key_hint": "o",
              "look": "text.muted",
              "text": "pen"
            },
            {
              "ink": "muted",
              "text": " · "
            },
            {
              "look": "text.muted",
              "text": "cop"
            },
            {
              "key_hint": "y",
              "look": "text.muted underline",
              "text": "y"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "2 Repository access: the repositories to follow."
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "3 Permissions come filled in from access: contents, pull requests, actions, statuses: read."
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "4 Generate token, copy the github_pat_… value into token, or:"
            }
