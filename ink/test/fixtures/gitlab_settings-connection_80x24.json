      "block": "section",
      "blocks": [
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "1 Open GitLab's new-token page:"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "accent",
              "link": "https://gitlab.com/-/user_settings/personal_access_tokens?name=radar&scopes=read_api",
              "text": "gitlab.com / new token"
            },
            {
              "ink": "muted",
              "text": "   "
            },
            {
              "look": "text.muted underline",
              "text": "o"
            },
            {
              "key_hint": "o",
              "look": "text.muted",
              "text": "pen"
            },
            {
              "ink": "muted",
              "text": " · "
            },
            {
              "look": "text.muted",
              "text": "cop"
            },
            {
              "key_hint": "y",
              "look": "text.muted underline",
              "text": "y"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "  name radar · scope from access: read_api"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "2 Pick an expiry date, then Create personal access token."
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "3 Copy the glpat-… value into token, or keep it out of radar's config:"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "muted",
              "text": "$ "
            },
            {
              "ink": "primary",
              "text": "export GITLAB_TOKEN=glpat-…"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "  then the token is env:GITLAB_TOKEN"
            }
          ]
        }
      ],
      "mark": "connection",
