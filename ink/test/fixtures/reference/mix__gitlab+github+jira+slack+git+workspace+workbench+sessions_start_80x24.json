        {
          "icon": "issue",
          "label": "jira",
          "mnemonic": "J",
          "target": "chrome:tab:2"
        },
        {
          "icon": "chat",
          "label": "slack",
          "mnemonic": "S",
          "target": "chrome:tab:3"
        },
        {
          "icon": "branch",
          "label": "branches",
          "mnemonic": "B",
          "target": "chrome:tab:4"
        },
        {
          "label": "work",
          "mnemonic": "I",
          "target": "chrome:tab:6"
        },
        {
          "icon": "log",
          "label": "history",
