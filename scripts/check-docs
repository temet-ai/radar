#!/usr/bin/env python3
"""Check local Markdown links, images and heading anchors without network access.

Checks the root guides, docs/, and component/agent READMEs. This is deliberately
not a full Markdown renderer or an external URL checker. Run from any directory.
"""

import re
import sys
from collections import Counter
from pathlib import Path
from urllib.parse import unquote, urlsplit

ROOT = Path(__file__).resolve().parent.parent


def prose(text):
    """Ignore fenced examples while retaining line numbers for diagnostics."""
    result = []
    fence = None
    for line in text.splitlines():
        marker = re.match(r"^\s{0,3}(`{3,}|~{3,})", line)
        if fence:
            if marker and marker[1][0] == fence[0] and len(marker[1]) >= len(fence):
                fence = None
            result.append("")
        elif marker:
            fence = marker[1]
            result.append("")
        else:
            result.append(line)
    return "\n".join(result)


def anchors(text):
    """GitHub-style IDs for the ATX headings used by these guides."""
    found = set()
    counts = Counter()
    for line in prose(text).splitlines():
        match = re.match(r"^\s{0,3}#{1,6}\s+(.+?)\s*#*\s*$", line)
        if not match:
            continue
        heading = re.sub(r"!?\[([^]]*)\]\([^)]*\)", r"\1", match[1])
        heading = re.sub(r"<[^>]*>", "", heading).replace("`", "")
        slug = re.sub(r"[^\w\- ]", "", heading.lower()).replace(" ", "-")
        suffix = counts[slug]
        candidate = f"{slug}-{suffix}" if suffix else slug
        while candidate in found:
            suffix += 1
            candidate = f"{slug}-{suffix}"
        counts[slug] = suffix + 1
        found.add(candidate)
    found.update(re.findall(r'<[^>]+\b(?:id|name)=["\']([^"\']+)["\']', text))
    return found


def destinations(text):
    """Yield inline/reference destinations and HTML image sources."""
    clean = prose(text)
    # Inline code is an example, not a link rendered by Markdown.
    clean = re.sub(r"(`+)(.*?)\1", lambda m: " " * len(m[0]), clean)
    patterns = [
        r"!?\[[^]\n]*\]\(\s*(<[^>]+>|[^\s)]+)(?:\s+[^)]*)?\)",
        r"^\s{0,3}\[[^]]+\]:\s*(<[^>]+>|\S+)",
        r'<img\b[^>]*\bsrc=["\']([^"\']+)["\']',
    ]
    for pattern in patterns:
        for match in re.finditer(pattern, clean, re.MULTILINE):
            yield clean.count("\n", 0, match.start()) + 1, match[1].strip("<>")


def check(files, root=ROOT):
    failures = []
    checked = 0
    headings = {}
    for source in files:
        for line, destination in destinations(source.read_text(encoding="utf-8")):
            url = urlsplit(destination)
            if url.scheme or url.netloc:
                continue
            path = unquote(url.path)
            target = (root / path.lstrip("/") if path.startswith("/") else source.parent / path) if path else source
            target = target.resolve()
            checked += 1
            label = f"{source.relative_to(root)}:{line}: {destination}"
            if not target.is_relative_to(root.resolve()):
                failures.append(f"{label} (target leaves repository)")
            elif not target.exists():
                failures.append(f"{label} (missing target)")
            elif url.fragment and target.suffix.lower() == ".md":
                if target not in headings:
                    headings[target] = anchors(target.read_text(encoding="utf-8"))
                if unquote(url.fragment) not in headings[target]:
                    failures.append(f"{label} (missing heading)")
    return checked, failures


def main():
    files = sorted(set(
        list(ROOT.glob("*.md"))
        + list((ROOT / "docs").rglob("*.md"))
        + [ROOT / "ink/README.md", ROOT / "sidecars/claude-agent/README.md"]
        + list((ROOT / "agents").rglob("*.md"))
    ))
    checked, failures = check(files)
    for failure in failures:
        print(failure, file=sys.stderr)
    print(f"Checked {checked} local links in {len(files)} Markdown files; {len(failures)} errors.")
    return bool(failures)


if __name__ == "__main__":
    sys.exit(main())
