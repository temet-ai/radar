          "block": "line",
          "text": [
            {
              "ink": "muted",
              "text": "$ "
            },
            {
              "ink": "primary",
              "text": "export GITHUB_TOKEN=…"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "  then the token is env:GITHUB_TOKEN"
            }
          ]
