#!/usr/bin/env python3
"""Summarise the latency lines a RADAR_TRACE_LATENCY=1 run wrote to radar.log.

    scripts/latency-report [radar.log ...]     (default: $XDG_STATE_HOME/radar/radar.log.1 and radar.log)

Prints, per kind (a key's echo, a streamed word, a message sent, a session made ready, any
other snapshot), the count and the p50, p90 and largest milliseconds from the cause to the
frame painted, and the host's and Ink's shares of it. The budget: a key's echo under 16 ms,
a streamed word and a sent message under 50 ms.
"""
import os
import re
import sys

SNAP = re.compile(
    r"ink: latency snapshot \d+ answers (?P<cause>.+?): host (?P<host>[\d.]+) \+ pipe (?P<pipe>-?[\d.]+) "
    r"\+ ink (?P<ink>[\d.]+) = (?P<total>[\d.]+) ms(?:; key (?P<key>[\d.]+) ms \(seq \d+\))?, (?P<bytes>\d+) bytes"
)
KEY = re.compile(r"ink: latency key: painted (?P<ms>[\d.]+) ms")
HOST = re.compile(r"latency host: cursor \d+ answers (?P<cause>.+?)(?: \(seq \d+\))?: (?P<ms>[\d.]+) ms since \(build (?P<build>[\d.]+)")


def kind(cause):
    if cause.startswith("session ready"):
        return "session ready (ctrl-t to the composer taking text, painted)"
    if cause == "event wake":
        return "streamed words (agent output woke the host, painted)"
    if cause.startswith("message shown"):
        return "message sent (composer Enter to the message in the transcript, painted)"
    if cause == "intent dock send":
        return "composer Enter (to the snapshot answering it, painted)"
    if cause.startswith("intent key"):
        return "a key the host answers (key to its snapshot, painted)"
    return "other snapshots (" + cause + ")"


def pct(xs, p):
    xs = sorted(xs)
    return xs[min(len(xs) - 1, int(len(xs) * p))] if xs else float("nan")


def row(name, xs):
    if not xs:
        return
    print(f"  {name:<14} n={len(xs):<5} p50 {pct(xs, 0.5):7.1f}  p90 {pct(xs, 0.9):7.1f}  max {max(xs):7.1f}")


def main(paths):
    if not paths:
        state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
        paths = [p for p in (os.path.join(state, "radar", "radar.log.1"), os.path.join(state, "radar", "radar.log")) if os.path.exists(p)]
    groups, keys, builds = {}, [], []
    for path in paths:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                m = SNAP.search(line)
                if m:
                    g = groups.setdefault(kind(m["cause"]), {"total": [], "host": [], "ink": [], "key": [], "bytes": []})
                    for k in ("total", "host", "ink", "bytes"):
                        g[k].append(float(m[k]))
                    if m["key"]:
                        g["key"].append(float(m["key"]))
                    continue
                m = KEY.search(line)
                if m:
                    keys.append(float(m["ms"]))
                    continue
                m = HOST.search(line)
                if m:
                    builds.append(float(m["build"]))
    print("ms; 'total' is from the cause on the host to the frame Ink wrote")
    if keys:
        print("a key's echo (stdin read to the next frame, Ink alone)")
        row("total", keys)
    for name in sorted(groups):
        g = groups[name]
        print(name)
        row("total", g["total"])
        row("host", g["host"])
        row("ink", g["ink"])
        row("from the key", g["key"])
        row("bytes", g["bytes"])
    if builds:
        print("the host building a snapshot")
        row("build", builds)


if __name__ == "__main__":
    main(sys.argv[1:])
