#!/usr/bin/env bash
# Refuses a commit that adds a private word: a client's, an employer's or a
# colleague's name, a real project or ticket key. The words are not in this
# repository; they are read from $RADAR_PRIVATE_WORDS, else
# ~/.config/radar-dev/private-words.txt (one extended regex per line, matched
# without case; blank lines and lines starting with # are skipped).
#
# Checked: every added line of the staged diff, and the staged file paths.
# Without the word list the commit is refused, so a machine that lost it
# notices. Turn it on in a checkout with `git config core.hooksPath scripts/hooks`.
set -euo pipefail

list=${RADAR_PRIVATE_WORDS:-$HOME/.config/radar-dev/private-words.txt}
if [ ! -s "$list" ]; then
    echo "pre-commit: no private word list at $list; create it (one regex per line) or set RADAR_PRIVATE_WORDS" >&2
    exit 1
fi

patterns=$(mktemp)
trap 'rm -f "$patterns"' EXIT
grep -v -E '^[[:space:]]*(#|$)' "$list" > "$patterns" || true
if [ ! -s "$patterns" ]; then
    echo "pre-commit: $list has no words in it" >&2
    exit 1
fi

hits=$(
    {
        git diff --cached --name-only --diff-filter=ACMR
        git diff --cached -U0 --no-color --diff-filter=ACMR | grep -E '^[+]' | grep -v -E '^[+][+][+] '
    } | grep -n -i -E -f "$patterns" || true
)
if [ -n "$hits" ]; then
    echo "pre-commit: refused, the staged change adds a private word (list: $list):" >&2
    printf '%s\n' "$hits" | cut -c1-200 >&2
    exit 1
fi
