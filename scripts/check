#!/usr/bin/env bash
# Run radar's checks and say plainly what failed: each check runs to the end
# (every failing crate, test and mix, not the first), its full output goes to
# target/check/<name>.log, and the end lists only the failures, each once, at
# its file:line (scripts/check-summary).
#
#   scripts/check                      clippy, tests, mixes, ink
#   scripts/check clippy test          only those
#   scripts/check clippy test -p radar-core -p radar-gitlab
#                                      clippy and nextest on those crates only
#
# Checks: clippy, test (nextest, all features), mixes (scripts/check-mixes),
# ink (typecheck and npm test). Works with bash 3.2 (macOS).

cd "$(dirname "$0")/.."

checks=()
crates=()
while [ $# -gt 0 ]; do
    case "$1" in
        clippy | test | mixes | ink) checks+=("$1") ;;
        -p) shift; crates+=(-p "$1") ;;
        -h | --help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown check: $1 (clippy, test, mixes, ink, -p <crate>)" >&2; exit 2 ;;
    esac
    shift
done
[ "${#checks[@]}" -eq 0 ] && checks=(clippy test mixes ink)
scope=(--workspace)
[ "${#crates[@]}" -gt 0 ] && scope=("${crates[@]}")

logs=target/check
mkdir -p "$logs"
export CARGO_TERM_COLOR=never NO_COLOR=1 FORCE_COLOR=0

run() {
    case "$1" in
        clippy) cargo clippy "${scope[@]}" --all-features --all-targets --keep-going -- -D warnings ;;
        test) cargo nextest run "${scope[@]}" --all-features --no-fail-fast ;;
        mixes) scripts/check-mixes ;;
        ink) (cd ink && { npm run typecheck; t=$?; npm test; s=$?; [ $t -eq 0 ] && [ $s -eq 0 ]; }) ;;
    esac
}

# The count a passing check ends with, for the "ok" line.
tally() {
    case "$1" in
        test) grep -E '^ *Summary ' "$2" | tail -1 | sed 's/^ *//' ;;
        mixes) grep -E 'every mix builds and passes' "$2" | tail -1 ;;
        ink) grep -E '^ *Tests +[0-9]' "$2" | tail -1 | sed 's/^ *//' ;;
    esac
}

failed=0
report=()
for c in "${checks[@]}"; do
    log="$logs/$c.log"
    started=$(date +%s)
    echo "== $c (log: $log)"
    run "$c" >"$log" 2>&1
    status=$?
    took="$(($(date +%s) - started))s"
    if [ $status -eq 0 ]; then
        report+=("$(printf '%-7s ok    %s  %s' "$c" "$took" "$(tally "$c" "$log")")")
    else
        failed=1
        report+=("$(printf '%-7s FAIL  %s  %s' "$c" "$took" "$log")")
        found=$(scripts/check-summary "$log")
        if [ -n "$found" ]; then
            report+=("$found")
        else
            report+=("  (no failure recognised: read the end of $log)")
            report+=("$(tail -5 "$log" | sed 's/^/  | /')")
        fi
    fi
done

echo
for line in "${report[@]}"; do
    printf '%s\n' "$line"
done
exit $failed
