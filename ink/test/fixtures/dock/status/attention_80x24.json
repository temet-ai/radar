{
  "chrome": {
    "height": 24,
    "keys_at": "body",
    "screen_keys": [
      "D"
    ],
    "status": {
      "attention": {
        "icon": "warning",
        "ink": "warn",
        "keys": "`",
        "target": "chrome:attention",
        "text": "review dock needs you +2"
      },
      "hints": [
        {
          "icon": "scroll",
          "keys": "PgUp/PgDn",
          "keys_of": [
            {
              "chord": {
                "key": "page_up"
              },
              "label": "PgUp",
              "target": "chrome:key:0:0"
            },
            {
              "chord": {
                "key": "page_down"
              },
              "label": "PgDn",
              "target": "chrome:key:0:1"
            }
          ],
          "label": "scroll"
        },
        {
          "icon": "quit",
          "keys": "q",
          "keys_of": [
            {
              "chord": {
                "key": {
                  "char": "q"
                }
              },
              "label": "q",
              "target": "chrome:key:1:0"
            }
          ],
          "label": "quit"
        },
        {
          "icon": "menu",
          "keys": "x",
          "keys_of": [
            {
              "chord": {
                "key": {
                  "char": "x"
                }
              },
              "label": "x",
              "target": "chrome:key:2:0"
            }
          ],
          "label": "menu"
        },
        {
          "keys": "←→↑↓",
          "keys_of": [
            {
              "chord": {
                "key": "left"
              },
              "label": "←",
              "target": "chrome:key:3:0"
            },
            {
              "chord": {
                "key": "right"
              },
              "label": "→",
              "target": "chrome:key:3:1"
            },
            {
              "chord": {
                "key": "up"
              },
              "label": "↑",
              "target": "chrome:key:3:2"
            },
            {
              "chord": {
                "key": "down"
              },
              "label": "↓",
              "target": "chrome:key:3:3"
            }
          ],
          "label": "navigate"
        }
      ],
      "least_needed": [
        "navigate",
        "scroll",
        "quit",
        "expand/collapse"
      ],
      "scope": "DOCKED"
    },
    "top_bar": {
      "brand": "radar",
      "mode": {
        "ink": "secondary",
        "target": "chrome:mode",
        "text": "✎ edit"
      },
      "tabs": [
        {
          "active": true,
          "label": "Docked",
          "mnemonic": "D",
          "target": "chrome:tab:0"
        },
        {
          "icon": "log",
          "label": "history",
          "mnemonic": "H",
          "target": "chrome:history"
        },
        {
          "icon": "settings",
          "label": "settings",
          "mnemonic": ",",
          "target": "chrome:settings"
        }
      ]
    },
    "version": 1,
    "width": 80
  },
  "row": " DOCKED   `  review dock needs you +2   PgUp/PgDn scroll   q quit   x menu"
}
