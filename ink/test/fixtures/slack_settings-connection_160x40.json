        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "1 Open Slack's new-app page, radar's manifest filled in:"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "accent",
              "link": "https://api.slack.com/apps?new_app=1&manifest_json=%7B%22_metadata%22%3A%7B%22major_version%22%3A1%2C%22minor_version%22%3A1%7D%2C%22display_information%22%3A%7B%22description%22%3A%22radar%20reads%20Slack%20as%20you%2C%20with%20a%20user%20token.%22%2C%22name%22%3A%22radar%22%7D%2C%22oauth_config%22%3A%7B%22scopes%22%3A%7B%22user%22%3A%5B%22channels%3Ahistory%22%2C%22channels%3Aread%22%2C%22groups%3Ahistory%22%2C%22groups%3Aread%22%2C%22search%3Aread%22%2C%22users%3Aread%22%2C%22usergroups%3Aread%22%2C%22chat%3Awrite%22%2C%22reactions%3Awrite%22%2C%22files%3Aread%22%5D%7D%7D%2C%22settings%22%3A%7B%22org_deploy_enabled%22%3Afalse%2C%22socket_mode_enabled%22%3Afalse%2C%22token_rotation_enabled%22%3Afalse%7D%7D",
              "text": "api.slack.com / new app"
            },
            {
              "ink": "muted",
              "text": "   "
            },
            {
              "look": "text.muted underline",
              "text": "o"
            },
            {
              "key_hint": "o",
              "look": "text.muted",
              "text": "pen"
            },
            {
              "ink": "muted",
              "text": " · "
            },
            {
              "look": "text.muted",
              "text": "copy "
            },
            {
              "look": "text.muted underline",
              "text": "m"
            },
            {
              "key_hint": "m",
              "look": "text.muted",
              "text": "anifest"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "  user scopes only: 10"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "2 Pick your workspace, Next, Create."
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "3 Install to Workspace, then Allow."
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "4 OAuth & Permissions shows the User OAuth Token, xoxp-…: paste it into token, or:"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "muted",
              "text": "$ "
            },
            {
              "ink": "primary",
              "text": "export SLACK_TOKEN=xoxp-…"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "secondary",
              "text": "  then the token is env:SLACK_TOKEN"
            }
          ]
        },
        {
          "block": "line",
          "text": [
            {
              "ink": "accent",
              "link": "https://api.slack.com/apps",
              "text": "api.slack.com / your apps"
            }
          ]
        }
      ],
      "detail": "about two minutes, once",
