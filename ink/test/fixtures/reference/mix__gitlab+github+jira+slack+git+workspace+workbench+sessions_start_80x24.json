            {
              "chord": {
                "key": "right"
              },
              "label": "→",
              "target": "chrome:key:3:1"
            },
            {
              "chord": {
                "key": "up"
              },
              "label": "↑",
              "target": "chrome:key:3:2"
            },
            {
              "chord": {
                "key": "down"
              },
              "label": "↓",
              "target": "chrome:key:3:3"
            }
          ],
          "label": "navigate"
