#!/usr/bin/env bash
# Pictures of every place radar draws, from sample data, and a page to look at them.
#
#   scripts/shots                       every recorded view fixture at 80x24 and 160x40
#                                       into shots/, with shots/index.html (a grid,
#                                       dark and light)
#   scripts/shots --out DIR             another folder
#   scripts/shots --compare REF         the same places drawn from git ref REF (a
#                                       temporary worktree) beside the working tree:
#                                       each place that changed shows before | after,
#                                       unchanged ones are folded away
#   scripts/shots --sizes 80x24         other sizes (fixtures exist at 80x24 and 160x40)
#   scripts/shots --no-png              SVG only (no PNG; browsers show SVG fine)
#
# A place is a recorded view fixture (ink/test/fixtures/*.json). Ink draws each one
# through the whole App to styled cells (ink/tools/shots/draw.test.tsx) and the cells
# become SVG (ink/tools/shots/svg.ts), then PNG with rsvg-convert. SVG is
# deterministic: two renders of the same screen are the same bytes, so "changed" is
# a byte comparison. Open DIR/index.html.
#
# With --compare, REF is drawn from its own fixtures and its own Ink source; if REF
# has no ink/tools/shots yet, the working tree's copy is put into the worktree.
#
# Works with bash 3.2 (macOS) and GNU or BSD tools. Needs node, git and ink/node_modules
# (cd ink && npm ci); PNG needs rsvg-convert, else the pictures are SVG.

set -e

cd "$(dirname "$0")/.."
root=$(pwd)

out=shots
ref=
sizes=80x24,160x40
format=both
while [ $# -gt 0 ]; do
    case "$1" in
        --out) out=$2; shift 2 ;;
        --compare) ref=$2; shift 2 ;;
        --sizes) sizes=$2; shift 2 ;;
        --no-png) format=svg; shift ;;
        -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "scripts/shots: unknown option $1 (see --help)" >&2; exit 2 ;;
    esac
done

if [ "$format" = both ] && ! command -v rsvg-convert >/dev/null 2>&1; then
    echo "scripts/shots: rsvg-convert not found, writing SVG only" >&2
    format=svg
fi

rm -rf "$out"
mkdir -p "$out"
out=$(cd "$out" && pwd)

tmp=$(mktemp -d "${TMPDIR:-/tmp}/radar-shots.XXXXXX")
cleanup() {
    if [ -n "${worktree:-}" ] && [ -d "$worktree" ]; then
        rm -f "$worktree/ink/node_modules"
        git worktree remove --force "$worktree" >/dev/null 2>&1 || true
    fi
    rm -rf "$tmp"
}
trap cleanup EXIT

esc() {
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# radar's places, "name<TAB>title" a line, as drawn into folder $1.
places() {
    cat "$1/places.tsv"
}

# Draw every place of the tree at $1 into folder $2: SVG, then PNG.
draw() {
    mkdir -p "$2"
    (cd "$1/ink" && FORCE_COLOR=3 SHOTS_OUT="$2" SHOTS_SIZES="$sizes" npx --no-install vitest run --config tools/shots/vitest.config.ts >"$tmp/draw.log" 2>&1) || {
        cat "$tmp/draw.log" >&2
        echo "scripts/shots: drawing $1 failed" >&2
        exit 1
    }
    if [ "$format" = both ]; then
        for svg in "$2"/*.svg; do
            rsvg-convert "$svg" -o "${svg%.svg}.png"
        done
    fi
}

ext=png
[ "$format" = svg ] && ext=svg

# --- the page ------------------------------------------------------------------
page_head() {
    cat <<'EOF'
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>radar shots</title>
<style>
:root { --page: #f4f4f6; --ink: #1c1c22; --muted: #5d5d68; --line: #cfcfd8; --chip: #e5e5ec; }
@media (prefers-color-scheme: dark) { :root:not([data-page="light"]) { --page: #15151a; --ink: #e6e6ee; --muted: #9a9aa8; --line: #34343e; --chip: #26262e; } }
:root[data-page="dark"] { --page: #15151a; --ink: #e6e6ee; --muted: #9a9aa8; --line: #34343e; --chip: #26262e; }
:root[data-page="light"] { --page: #f4f4f6; --ink: #1c1c22; --muted: #5d5d68; --line: #cfcfd8; --chip: #e5e5ec; }
body { margin: 0; padding: 0 16px 48px; background: var(--page); color: var(--ink); font: 15px/1.45 system-ui, sans-serif; }
header { display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline; padding: 16px 0 8px; position: sticky; top: 0; background: var(--page); z-index: 1; border-bottom: 1px solid var(--line); }
h1 { font-size: 18px; margin: 0; }
h2 { font-size: 15px; margin: 0 0 8px; }
.note { color: var(--muted); }
button { font: inherit; color: var(--ink); background: var(--chip); border: 1px solid var(--line); border-radius: 6px; padding: 2px 10px; cursor: pointer; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 640px), 1fr)); gap: 24px; margin-top: 20px; }
figure { margin: 0; padding: 12px; border: 1px solid var(--line); border-radius: 8px; min-width: 0; }
figcaption { margin-bottom: 8px; }
figcaption code { color: var(--muted); font-size: 12px; margin-left: 6px; }
.size { color: var(--muted); font-size: 12px; margin: 10px 0 4px; }
.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.pair div > span { display: block; color: var(--muted); font-size: 12px; margin-bottom: 2px; }
img { max-width: 100%; height: auto; display: block; border-radius: 4px; }
details { margin-top: 24px; }
summary { cursor: pointer; color: var(--muted); }
details ul { columns: 3 260px; padding-left: 18px; }
</style>
</head>
<body>
EOF
}

page_foot() {
    cat <<'EOF'
<script>
(function () {
  var root = document.documentElement, b = document.getElementById("page");
  try { var saved = localStorage.getItem("radar-shots-page"); if (saved) root.setAttribute("data-page", saved); } catch (e) {}
  function now() { return root.getAttribute("data-page") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"); }
  function label() { b.textContent = "page: " + now() + " (switch)"; }
  b.onclick = function () {
    var next = now() === "dark" ? "light" : "dark";
    root.setAttribute("data-page", next);
    try { localStorage.setItem("radar-shots-page", next); } catch (e) {}
    label();
  };
  label();
})();
</script>
</body>
</html>
EOF
}

# Every size drawn, as the names of the files for place $1: "WxH" a line.
sizes_of() {
    echo "$sizes" | tr ',' '\n'
}

if [ -z "$ref" ]; then
    # --- one tree ---------------------------------------------------------------
    draw "$root" "$out"
    places "$out" > "$tmp/places"
    {
        page_head
        echo '<header><h1>radar shots</h1><span class="note">'"$(wc -l < "$tmp/places" | tr -d ' ')"' places, from sample data</span><button id="page"></button></header>'
        echo '<div class="grid">'
        while IFS="$(printf '\t')" read -r name title; do
            echo "<figure><figcaption><strong>$(printf '%s' "$title" | esc)</strong><code>$name</code></figcaption>"
            sizes_of | while read -r size; do
                echo "<div class=\"size\">$size</div><a href=\"${name}_${size}.svg\"><img loading=\"lazy\" alt=\"$name at $size\" src=\"${name}_${size}.${ext}\"></a>"
            done
            echo "</figure>"
        done < "$tmp/places"
        echo '</div>'
        page_foot
    } > "$out/index.html"
    echo "$out/index.html"
    exit 0
fi

# --- compare --------------------------------------------------------------------
git rev-parse --verify --quiet "$ref^{commit}" >/dev/null || {
    echo "scripts/shots: $ref is not a git ref" >&2
    exit 2
}
mkdir -p "$root/.claude/worktrees"
worktree="$root/.claude/worktrees/shots-ref-$$"
git worktree add --detach "$worktree" "$ref" >/dev/null 2>&1
ln -s "$root/ink/node_modules" "$worktree/ink/node_modules"
if [ ! -f "$worktree/ink/tools/shots/draw.test.tsx" ]; then
    echo "$ref predates ink/tools/shots: using the working tree's copy" >&2
    mkdir -p "$worktree/ink/tools"
    cp -R "$root/ink/tools/shots" "$worktree/ink/tools/shots"
fi

echo "drawing $ref..." >&2
draw "$worktree" "$out/before"
echo "drawing the working tree..." >&2
draw "$root" "$out/after"
places "$out/after" > "$tmp/places"
places "$out/before" > "$tmp/places-before"
# What changed: a place is changed when any of its SVGs differs, new when only
# the working tree has it, gone when only the ref does.
: > "$tmp/changed"
: > "$tmp/same"
: > "$tmp/new"
while IFS="$(printf '\t')" read -r name title; do
    if ! cut -f1 "$tmp/places-before" | grep -qx -- "$name"; then
        echo "$name" >> "$tmp/new"
        continue
    fi
    diff_found=0
    for size in $(sizes_of); do
        cmp -s "$out/before/${name}_${size}.svg" "$out/after/${name}_${size}.svg" || diff_found=1
    done
    if [ "$diff_found" -eq 1 ]; then
        echo "$name" >> "$tmp/changed"
    else
        echo "$name" >> "$tmp/same"
    fi
done < "$tmp/places"
cut -f1 "$tmp/places-before" | while read -r name; do
    cut -f1 "$tmp/places" | grep -qx -- "$name" || echo "$name"
done > "$tmp/gone"

title_of() {
    awk -F '\t' -v n="$1" '$1 == n { print $2; exit }' "$tmp/places"
}

n_changed=$(wc -l < "$tmp/changed" | tr -d ' ')
n_same=$(wc -l < "$tmp/same" | tr -d ' ')
n_new=$(wc -l < "$tmp/new" | tr -d ' ')
n_gone=$(wc -l < "$tmp/gone" | tr -d ' ')
{
    page_head
    echo '<header><h1>radar shots: '"$(printf '%s' "$ref" | esc)"' | working tree</h1><span class="note">'"$n_changed changed, $n_new new, $n_gone gone, $n_same unchanged"'</span><button id="page"></button></header>'
    if [ "$n_changed" -eq 0 ]; then
        echo '<p class="note">Nothing drawn differs from '"$(printf '%s' "$ref" | esc)"'.</p>'
    fi
    echo '<div class="grid">'
    while read -r name; do
        echo "<figure><figcaption><strong>$(title_of "$name" | esc)</strong><code>$name</code></figcaption>"
        for size in $(sizes_of); do
            if ! cmp -s "$out/before/${name}_${size}.svg" "$out/after/${name}_${size}.svg"; then
                echo "<div class=\"size\">$size</div><div class=\"pair\">"
                echo "<div><span>before ($(printf '%s' "$ref" | esc))</span><a href=\"before/${name}_${size}.svg\"><img loading=\"lazy\" alt=\"before\" src=\"before/${name}_${size}.${ext}\"></a></div>"
                echo "<div><span>after (working tree)</span><a href=\"after/${name}_${size}.svg\"><img loading=\"lazy\" alt=\"after\" src=\"after/${name}_${size}.${ext}\"></a></div>"
                echo "</div>"
            fi
        done
        echo "</figure>"
    done < "$tmp/changed"
    while read -r name; do
        echo "<figure><figcaption><strong>$(title_of "$name" | esc)</strong> <em>(new)</em><code>$name</code></figcaption>"
        for size in $(sizes_of); do
            echo "<div class=\"size\">$size</div><a href=\"after/${name}_${size}.svg\"><img loading=\"lazy\" alt=\"$name\" src=\"after/${name}_${size}.${ext}\"></a>"
        done
        echo "</figure>"
    done < "$tmp/new"
    echo '</div>'
    if [ "$n_gone" -gt 0 ]; then
        echo '<details><summary>'"$n_gone"' only in '"$(printf '%s' "$ref" | esc)"' (gone)</summary><ul>'
        while read -r name; do echo "<li><code>$name</code></li>"; done < "$tmp/gone"
        echo '</ul></details>'
    fi
    echo '<details><summary>'"$n_same"' unchanged</summary><ul>'
    while read -r name; do echo "<li>$(title_of "$name" | esc) <code>$name</code></li>"; done < "$tmp/same"
    echo '</ul></details>'
    page_foot
} > "$out/index.html"

echo "compared with $ref: $n_changed changed, $n_new new, $n_gone gone, $n_same unchanged" >&2
echo "$out/index.html"
