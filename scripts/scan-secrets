#!/usr/bin/env bash
# scan-secrets PATH... [--also LITERAL]...
# Fails (exit 1) when a file under PATH holds a token-shaped value, an email
# address other than example.com/example.org/noreply, this machine's home
# path, the git user's email or name, the hostname, a Copilot login, or an
# --also literal.
# Prints file:line and the kind only, never the matched text.
set -u

paths=()
also=()
while [ $# -gt 0 ]; do
  case "$1" in
    --also) shift; [ $# -gt 0 ] && also+=("$1") ;;
    -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
    *) paths+=("$1") ;;
  esac
  shift
done
[ ${#paths[@]} -gt 0 ] || { echo "usage: scan-secrets PATH... [--also LITERAL]" >&2; exit 2; }

found=0
report() { # kind, then grep -n output lines on stdin (file:line:...)
  local kind="$1" line
  while IFS= read -r line; do
    printf '%s: %s\n' "$(printf '%s' "$line" | awk -F: '{print $1 ":" $2}')" "$kind"
    found=1
  done
}

scan_re() { # kind, ERE
  report "$1" < <(grep -rnIoE -- "$2" "${paths[@]}" 2>/dev/null)
}
scan_lit() { # kind, literal
  [ -n "$2" ] || return 0
  report "$1" < <(grep -rnIoF -- "$2" "${paths[@]}" 2>/dev/null)
}
scan_word() { # kind, literal matched as a whole word
  [ -n "$2" ] || return 0
  report "$1" < <(grep -rnIowF -- "$2" "${paths[@]}" 2>/dev/null)
}

scan_re "github token"   'gh[opusr]_[A-Za-z0-9]{20,}'
scan_re "github token"   'github_pat_[A-Za-z0-9_]{20,}'
scan_re "gitlab token"   'glpat-[A-Za-z0-9_-]{20,}'
scan_re "slack token"    'xox[abposr]-[A-Za-z0-9-]{10,}'
scan_re "api key"        'sk-(ant-|proj-)?[A-Za-z0-9_-]{20,}'
scan_re "jwt"            'eyJ[A-Za-z0-9_-]{10,}[.]eyJ[A-Za-z0-9_-]{10,}'
scan_re "bearer"         '[Bb]earer [A-Za-z0-9._~+/-]{20,}'
scan_re "token field"    '"(access|refresh|id|auth|api)_?([Tt]oken|[Kk]ey)"[[:space:]]*:[[:space:]]*"[^"]{8,}"'
report "email" < <(grep -rnIoE -- '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}' "${paths[@]}" 2>/dev/null \
  | grep -vE ':[^:]*@(example[.](com|org)|users[.]noreply[.]github[.]com)$' | grep -vE ':noreply@')
scan_lit "home path" "${HOME:-}"
scan_lit "git email" "$(git config user.email 2>/dev/null)"
scan_word "git name" "$(git config user.name 2>/dev/null)"
scan_word "hostname" "$(hostname 2>/dev/null)"
if [ -r "$HOME/.copilot/config.json" ]; then
  while IFS= read -r login; do scan_lit "copilot login" "$login"; done < <(
    grep -oE '"login"[[:space:]]*:[[:space:]]*"[^"]+"' "$HOME/.copilot/config.json" \
      | sed -E 's/.*:[[:space:]]*"([^"]+)"/\1/' | sort -u)
fi
for a in ${also[@]+"${also[@]}"}; do scan_lit "--also" "$a"; done

if [ "$found" -eq 0 ]; then
  echo "clean: ${paths[*]}"
  exit 0
fi
echo "replace each with a placeholder (user@example.com, /home/user, <login>) and scan again" >&2
exit 1
