#!/usr/bin/env bash
# Check radar in its mixes of parts and run tests/mix.rs in each: no parts,
# each part alone, all parts, each adapter with its part, and the shipped mix
# (every part and adapter).
#
#   scripts/check-mixes              per commit and at merge (`--quick` is
#                                    the same run, kept for callers)
#
# Not here: a crate's own suite (its session runs `-p <crate>`, CI runs the
# workspace once) and the 2^n combinations of parts. The guard in
# tests/parts.rs keeps parts from naming each other, so a part that works
# alone and with all the others has no pair of its own to test (GUIDE 1.14).
# A mix whose check fails does not run its tests.
# Uses cargo-nextest when installed. Works with bash 3.2 (macOS) and GNU or
# BSD tools.

# Not -u: bash 3.2 calls an empty array unbound.
set -e

cd "$(dirname "$0")/.."

case "${1:-}" in
    --quick | "") ;;
    *) echo "usage: $0 [--quick]" >&2; exit 2 ;;
esac

if cargo nextest --version >/dev/null 2>&1; then
    test_cmd="cargo nextest run"
else
    test_cmd="cargo test --no-fail-fast"
fi

# The parts: the features in the root Cargo.toml that name a part crate
# (`dep:radar-<name>`), not `default` nor the tooling ones (`shots`, `png`, `demo`, `test-support`).
parts=()
while IFS= read -r name; do
    [ -n "$name" ] && parts+=("$name")
done <<EOF
$(awk '
    /^\[features\]/ { on = 1; next }
    /^\[/ { on = 0 }
    on && /^[A-Za-z0-9_-]+[ \t]*=/ && index($0, "dep:radar-") {
        name = $0
        sub(/[ \t]*=.*/, "", name)
        print name
    }
' Cargo.toml)
EOF

# A feature named `<part>-<x>`, where `<part>` is a part, is an adapter of that
# part (`sessions-codex`), not a part: it is checked once with its part alone
# and once in the shipped mix with every adapter.
is_part() {
    for p in "${parts[@]}"; do
        [ "$p" = "$1" ] && return 0
    done
    return 1
}
adapters=()
plain=()
for f in "${parts[@]}"; do
    owner=${f%%-*}
    if [ "$owner" != "$f" ] && is_part "$owner"; then
        adapters+=("$f")
    else
        plain+=("$f")
    fi
done
parts=("${plain[@]}")

echo "parts: ${parts[*]:-none}"
echo "adapters: ${adapters[*]:-none}"

failed=()
started=$(date +%s)

# One mix: its check, then tests/mix.rs with the parts' sample data. The
# tests are skipped when the check fails; the build would fail the same way.
mix() {
    echo
    echo "== $test_cmd mix [${1:-no parts}]"
    if ! cargo check --no-default-features --features "$1"; then
        failed+=("cargo check --no-default-features --features \"$1\"")
        return
    fi
    # shellcheck disable=SC2086
    if ! $test_cmd -p radar --no-default-features --features "${1:+$1,}demo,test-support" --test mix; then
        failed+=("$test_cmd -p radar --no-default-features --features \"${1:+$1,}demo,test-support\" --test mix")
    fi
}

mix ""
for p in "${parts[@]}"; do
    mix "$p"
done
all=""
for p in "${parts[@]}"; do
    all="${all:+$all,}$p"
done
[ "${#parts[@]}" -gt 1 ] && mix "$all"
if [ "${#adapters[@]}" -gt 0 ]; then
    for a in "${adapters[@]}"; do
        mix "${a%%-*},$a"
    done
    for a in "${adapters[@]}"; do
        all="${all:+$all,}$a"
    done
    mix "$all"
fi

echo
echo "took $(($(date +%s) - started))s"
if [ "${#failed[@]}" -gt 0 ]; then
    echo "FAILED:"
    for f in "${failed[@]}"; do
        echo "  $f"
    done
    exit 1
fi
echo "every mix builds and passes"
