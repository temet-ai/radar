exports[`recorded view fixtures > github_settings-connection at 80x24 1`] = `
"── settings ──
  SIGN IN  how radar reads GitHub
  ○ public only     public repositories, no token
  ○ gh's sign-in    asks gh for its token
  ● a token         env:NAME, or one pasted

  server          https://api.github.com
  token           env:GITHUB_TOKEN
  check           not checked yet
  refresh         once on start, then on request

  ACCESS  what radar may do on GitHub
  ● read only       pull requests, checks, runs
  ○ read and write  adds comment, approve, merge, re-run

  REPOSITORIES  github.com/owner, owner/repo or a group name
  + add a repository or group   paste or type it
    ◆ github.com/acme   2 repositories

── public only ──
 NOW
 env:GITHUB_TOKEN

 No token: radar reads public repositories only.

 ACCEPTS
 empty, gh, env:NAME, or a token

 config: [github] token
















── detail ──
 NOW                                                                           █
 env:GITHUB_TOKEN                                                              █
                                                                               █
 No token: radar reads public repositories only.                               █
                                                                               █
 ACCEPTS                                                                       █
 empty, gh, env:NAME, or a token                                               █
                                                                               █
 config: [github] token                                                        █
                                                                               █
 $ EASIEST: THE GH PROGRAM ────────────────────────────────────────────────────█
   Choose gh's sign-in. Not signed in yet?                                     █
   $ gh auth login                                                             █
   cli.github.com: install gh                                                  █
 ⇌ OR A TOKEN ─────────────────────────────────────────────────────────────────█
   Public repositories need none. For private ones:                            █
   1 Open the fine-grained token page:                                         █
   github.com / new token   open · copy                                        █
   2 Repository access: the repositories to follow.                            █
   3 Permissions come filled in from access: contents, pull requests, actions, ║
   statuses: read.                                                             ║
   4 Generate token, copy the github_pat_… value into token, or:               ║
   $ export GITHUB_TOKEN=…                                                     ║
     then the token is env:GITHUB_TOKEN                                        ║
"
`;

exports[`recorded view fixtures > github_settings-connection at 160x40 1`] = `
"── settings ──
  SIGN IN  how radar reads GitHub
  ○ public only     public repositories, no token
  ○ gh's sign-in    asks gh for its token
  ● a token         env:NAME, or one pasted

  server          https://api.github.com
  token           env:GITHUB_TOKEN
  check           not checked yet
  refresh         once on start, then on request

  ACCESS  what radar may do on GitHub
  ● read only       pull requests, checks, runs
  ○ read and write  adds comment, approve, merge, re-run

  REPOSITORIES  github.com/owner, owner/repo or a group name
  + add a repository or group   paste or type it
    ◆ github.com/acme   2 repositories

── public only ──
 NOW
 env:GITHUB_TOKEN

 No token: radar reads public repositories only.

 ACCEPTS
 empty, gh, env:NAME, or a token

 config: [github] token
































── detail ──
 NOW
 env:GITHUB_TOKEN

 No token: radar reads public repositories only.

 ACCEPTS
 empty, gh, env:NAME, or a token

 config: [github] token

 $ EASIEST: THE GH PROGRAM ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
   Choose gh's sign-in. Not signed in yet?
   $ gh auth login
   cli.github.com: install gh
 ⇌ OR A TOKEN ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
   Public repositories need none. For private ones:
   1 Open the fine-grained token page:
   github.com / new token   open · copy
   2 Repository access: the repositories to follow.
   3 Permissions come filled in from access: contents, pull requests, actions, statuses: read.
   4 Generate token, copy the github_pat_… value into token, or:
   $ export GITHUB_TOKEN=…
     then the token is env:GITHUB_TOKEN
 ⚇ AN ORGANISATION'S REPOSITORIES ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
   Choose the organisation as the token's resource owner.
   Some need an owner to approve the token.
 ↗ MORE ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
   GitHub docs: access tokens
   radar guide: connect GitHub











"
`;

