#!/usr/bin/env bash
# Build radar's JavaScript runtime: the Ink renderer and the Claude Code sidecar
# (runtime/entry.mjs) bundled into one Node single executable, radar-js, which the
# radar binary embeds when RADAR_RUNTIME_EMBED names it (build.rs). Prints its path
# on stdout and nothing else; npm's and esbuild's own output goes to stderr.
#
#   scripts/build-runtime            into target/runtime
#   scripts/build-runtime DIR        into DIR
#
# Needs a node that can build a single executable: 25.5 or later (`node
# --build-sea`), built with single executables in (Homebrew's node 26 is not:
# its `--build-sea` says "Single executable application is disabled"). The
# node on PATH is used when it can; otherwise the newest install on this
# machine that can (nvm, fnm, volta, asdf, mise, Homebrew's kegs, the system's,
# nvm-windows), and RADAR_NODE names one outright. Its npm goes with it. The
# executable is built from that node, so it is for this machine's platform:
# the release builds one per target on that target's runner.
# Works with bash 3.2 (macOS) and GNU or BSD tools; on Windows under Git Bash.

set -euo pipefail

cd "$(dirname "$0")/.."
root=$(pwd)
out="${1:-target/runtime}"
mkdir -p "$out"
out=$(cd "$out" && pwd)

exe=""
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) exe=".exe" ;;
esac

# Why the node `$1` cannot build a single executable; nothing when it can.
cannot_build_sea() {
    local n=$1 version sea
    [ -x "$n" ] || { echo "is not an executable"; return; }
    version=$("$n" --version 2>/dev/null) || { echo "does not start"; return; }
    if ! "$n" --help 2>/dev/null | grep -q -- '--build-sea'; then
        echo "is $version, which has no --build-sea; needs 25.5 or later"
        return
    fi
    sea=$("$n" -p 'process.config.variables.single_executable_application' 2>/dev/null) || sea=unknown
    [ "$sea" != false ] || echo "is $version, built without single executables"
}

# Every node installed on this machine that is not the one on PATH, newest
# first, one path a line.
other_nodes() {
    local on_path=$1 c version a b d
    shopt -s nullglob
    for c in \
        "${NVM_DIR:-$HOME/.nvm}"/versions/node/*/bin/node \
        "${FNM_DIR:-$HOME/.local/share/fnm}"/node-versions/*/installation/bin/node \
        "$HOME/Library/Application Support/fnm/node-versions"/*/installation/bin/node \
        "${VOLTA_HOME:-$HOME/.volta}"/tools/image/node/*/bin/node \
        "${ASDF_DATA_DIR:-$HOME/.asdf}"/installs/nodejs/*/bin/node \
        "${MISE_DATA_DIR:-$HOME/.local/share/mise}"/installs/node/*/bin/node \
        /opt/homebrew/Cellar/node*/*/bin/node \
        /usr/local/Cellar/node*/*/bin/node \
        /home/linuxbrew/.linuxbrew/Cellar/node*/*/bin/node \
        /usr/local/bin/node /usr/bin/node \
        "${NVM_HOME:-${APPDATA:-/nonexistent}/nvm}"/v*/node"$exe"
    do
        [ -x "$c" ] || continue
        [ -n "$on_path" ] && [ "$c" -ef "$on_path" ] && continue
        version=$("$c" --version 2>/dev/null) || continue
        IFS=. read -r a b d <<<"${version#v}"
        echo "${a:-0} ${b:-0} ${d:-0} $c"
    done | sort -k1,1nr -k2,2nr -k3,3nr | while read -r a b d c; do echo "$c"; done
    shopt -u nullglob
}

# The node that builds the executable, on stdout; what was passed over, on stderr.
node_for_sea() {
    local on_path why c tried=""
    if [ -n "${RADAR_NODE:-}" ]; then
        why=$(cannot_build_sea "$RADAR_NODE")
        if [ -n "$why" ]; then
            echo "build-runtime: RADAR_NODE=$RADAR_NODE $why" >&2
            return 1
        fi
        echo "$RADAR_NODE"
        return
    fi
    on_path=$(command -v node || true)
    if [ -n "$on_path" ]; then
        why=$(cannot_build_sea "$on_path")
        if [ -z "$why" ]; then
            echo "$on_path"
            return
        fi
        echo "build-runtime: the node on PATH ($on_path) $why; looking for another" >&2
        tried="$on_path $why"
    else
        echo "build-runtime: no node on PATH; looking for one installed here" >&2
    fi
    while IFS= read -r c; do
        why=$(cannot_build_sea "$c")
        if [ -z "$why" ]; then
            echo "build-runtime: using $c ($("$c" --version))" >&2
            echo "$c"
            return
        fi
        tried="$tried
$c $why"
    done <<<"$(other_nodes "$on_path")"
    {
        echo "build-runtime: no node here can build a single executable; needs node 25.5 or later built with single executables (not Homebrew's node 26)."
        echo "  install one (nvm install 25, fnm install 25, or nodejs.org), or name one: RADAR_NODE=/path/to/node"
        [ -z "$tried" ] || echo "  tried:$tried" | sed '2,$s/^/    /'
    } >&2
    return 1
}

NODE=$(node_for_sea)
# Its npm (and npx) go with it: the ink and sidecar installs, and npm's scripts.
PATH="$(dirname "$NODE"):$PATH"
export PATH

(cd ink && npm ci --no-audit --no-fund && npm run bundle) >&2
(cd sidecars/claude-agent && npm ci --omit=optional --no-audit --no-fund) >&2

# Anthropic's Agent SDK is left out: the sidecar fetches it from npm on first use
# (sidecars/claude-agent/src/sdk.js), so radar ships none of Anthropic's code.
# In a Node 26 single executable, import.meta.url is sometimes undefined (the
# same executable, about 4 starts in 10); every use in the bundle reads the
# executable's own file URL instead, which is what it holds when it is set.
"$root/ink/node_modules/.bin/esbuild" runtime/entry.mjs --bundle --platform=node --format=esm \
    --target=node24 --outfile="$out/radar-js.mjs" --log-level=warning \
    --banner:js='import { pathToFileURL as __radarFileUrl } from "node:url"; const __radarMetaUrl = import.meta.url ?? __radarFileUrl(process.execPath).href;' \
    --define:import.meta.url=__radarMetaUrl \
    --external:@anthropic-ai/claude-agent-sdk
if grep -q 'Anthropic PBC' "$out/radar-js.mjs"; then
    echo "build-runtime: the runtime carries Anthropic's code; the SDK must stay external" >&2
    exit 1
fi

# The executable starts as a copy of node. Debug symbols are stripped first:
# stripping after the build drops the embedded script. macOS signatures are
# taken off before the change and an ad hoc one put back after it.
base="$out/node$exe"
cp "$("$NODE" -p process.execPath)" "$base"
chmod u+w "$base"
case "$(uname -s)" in
    Darwin)
        codesign --remove-signature "$base"
        # Xcode's strip cannot process some node builds (Intel: "file not in an
        # order that can be processed"); the runtime then keeps node's symbols.
        strip -x "$base" 2>/dev/null || echo "build-runtime: strip refused $("$NODE" --version)'s binary; keeping its symbols" >&2
        ;;
    Linux)
        strip "$base"
        ;;
esac

cat > "$out/sea.json" <<EOF
{
  "main": "$out/radar-js.mjs",
  "mainFormat": "module",
  "executable": "$base",
  "output": "$out/radar-js$exe",
  "disableExperimentalSEAWarning": true,
  "useCodeCache": false
}
EOF
"$NODE" --build-sea "$out/sea.json" >/dev/null
rm "$base"
if [ "$(uname -s)" = Darwin ]; then
    codesign --sign - "$out/radar-js"
fi

# It must start and answer as the sidecar. A first start can be slow (a cold
# disk, a fresh signature being checked), so it gets three tries.
for try in 1 2 3; do
    reply=$(printf '{"id":1,"op":"hello"}\n' | "$out/radar-js$exe" claude-agent 2>/dev/null | head -n 1 || true)
    case "$reply" in
        *'"type":"ready"'*) break ;;
    esac
    if [ "$try" = 3 ]; then
        echo "build-runtime: $out/radar-js$exe did not start after 3 tries: $reply" >&2
        exit 1
    fi
    sleep 2
done
echo "$out/radar-js$exe"
